# Public URLs. Keep values empty in Git; configure them in Vercel.
DV9_SITE_URL=
TELEGRAM_WEBHOOK_BASE_URL=
VITE_TELEGRAM_BOT_URL=

# Owner access. First send /id to a bot, then add your numeric Telegram ID here.
# Multiple IDs may be separated with commas or spaces.
TELEGRAM_OWNER_IDS=

# Main private command bot. DV9 SYSTEM is always private in server code.
TELEGRAM_SYSTEM_BOT_TOKEN=
TELEGRAM_SYSTEM_WEBHOOK_SECRET=

# AI pilot (private until rate limits and public access are configured)
TELEGRAM_AIPILOT_BOT_TOKEN=
TELEGRAM_AIPILOT_WEBHOOK_SECRET=
TELEGRAM_AIPILOT_PRIVATE=true

# Premium bot
TELEGRAM_PREMIUM_BOT_TOKEN=
TELEGRAM_PREMIUM_WEBHOOK_SECRET=
TELEGRAM_PREMIUM_PRIVATE=true

# Construction bot
TELEGRAM_CONSTRUCTION_BOT_TOKEN=
TELEGRAM_CONSTRUCTION_WEBHOOK_SECRET=
TELEGRAM_CONSTRUCTION_PRIVATE=true

# Optional OpenAI-compatible provider. Keep the API key server-only and Sensitive.
DV9_AI_BASE_URL=
DV9_AI_API_KEY=
DV9_AI_MODEL=
DV9_AI_TIMEOUT_MS=45000

# Optional role-specific prompts
DV9_SYSTEM_SYSTEM_PROMPT=
DV9_AIPILOT_SYSTEM_PROMPT=
DV9_PREMIUM_SYSTEM_PROMPT=
DV9_CONSTRUCTION_SYSTEM_PROMPT=
